{
  "name": "playwright-test-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:local": "cross-env TEST_ENV=local playwright test",
    "test:test": "cross-env TEST_ENV=test playwright test",
    "test:api": "cross-env TEST_ENV=local playwright test --project=api",
    "test:dev": "cross-env TEST_ENV=dev playwright test --grep-invert @test-data",
    "test:staging": "cross-env TEST_ENV=staging playwright test --grep-invert @test-data",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:history:report": "node scripts/render-test-history.mjs",
    "test:history:unit": "node --test scripts/test-history.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"package.json\" \"playwright.config.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"eslint.config.mjs\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"package.json\" \"playwright.config.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"eslint.config.mjs\" \".github/**/*.yml\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
